[Unit]
Description=Muneral to Scrutator incremental graph sync
Documentation=https://github.com/Arcanada-one/scrutator
Wants=network-online.target
After=network-online.target
# Every START counts against the limit, not only failures. The timer fires every 5 minutes (OnCalendar=*:0/5), so a
# 15-minute window held three timer starts and the fourth was refused with `start-limit-hit` (seen 2026-11-13 15:15 CET,
# after three green runs). 10 minutes admit at most three timer starts even at the window boundary; the burst of 4 leaves
# at least one start for a retry (Restart=on-failure, RestartSec=30s), so a run that keeps failing still stops after
# a few attempts. tests/test_systemd_timer.py pins the relation between this limit and the timer period.
StartLimitIntervalSec=10min
StartLimitBurst=4
ConditionPathExists=/etc/muneral-kb-sync/muneral-db-dsn
ConditionPathExists=/etc/muneral-kb-sync/ltm-writer-token

[Service]
Type=oneshot
User=muneral-kb-sync
Group=muneral-kb-sync
LoadCredential=muneral-db-dsn:/etc/muneral-kb-sync/muneral-db-dsn
LoadCredential=ltm-writer-token:/etc/muneral-kb-sync/ltm-writer-token
StateDirectory=muneral-kb-sync/runtime
StateDirectoryMode=0750
WorkingDirectory=/opt/muneral-kb-sync/current
ExecStart=/opt/muneral-kb-sync/current/bin/muneral-kb-sync --incremental --timer --max-tasks 200
TimeoutStartSec=10min
Restart=on-failure
RestartSec=30s
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
SystemCallArchitectures=native
ReadWritePaths=/var/lib/muneral-kb-sync/runtime
