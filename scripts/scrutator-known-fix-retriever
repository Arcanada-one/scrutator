#!/bin/sh
# Keep the adapter usable when its caller passes PATH only. setup-python installs
# shared Python builds whose libpython lives beside the selected interpreter.
set -eu
python_path=$(command -v python3) || {
  echo "scrutator-known-fix-retriever: python3 not found on PATH" >&2
  exit 127
}
python_real=$(readlink -f "$python_path") || exit 127
python_dir=$(dirname "$python_real")
python_lib="$python_dir/../lib"
if [ -d "$python_lib" ]; then
  export LD_LIBRARY_PATH="$python_lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
exec "$python_path" "$(dirname "$0")/scrutator-known-fix-retriever.py" "$@"
